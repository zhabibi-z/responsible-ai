# Credentials / secrets
kaggle.json
.env
*.key

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/

# Tooling caches / editor
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/

# Data (regenerated from source URL on run)
data/
*.csv

# Generated reports: the Evidently HTML (~3-4 MB each) and the eval JSON are
# regenerated by src/underwriting/{monitoring,evaluate}.py, so they are not
# committed. The curated calibration diagram (reports/*.png) IS kept as a
# documentation asset (it renders in the README).
reports/*.html
reports/*.json

# Note: the small trained models (notebooks/models/, ~280 KB total) are
# intentionally committed so the app and the Hugging Face Space run without
# re-executing the notebook. They are well under the size where Git LFS is
# warranted.

# Packaging
*.egg-info/
build/
dist/

# Misc
*.log
.DS_Store

# Local Claude Code settings
.claude/
